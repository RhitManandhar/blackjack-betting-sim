{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vite.config.ts",
    "vitest.houseedge.config.ts",
    "vitest.perf.config.ts",
    "eslint.config.js",
    "eslint/**/*",
    "scripts/**/*"
  ]
}
